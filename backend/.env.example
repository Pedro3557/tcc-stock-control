# =============================================================================
# Configuração da API — copie para .env (o "npm run configurar" faz isso sozinho)
# Nunca versione o arquivo .env: ele contém senhas.
# =============================================================================

# --- Servidor -----------------------------------------------------------------
# Porta da API (em produção, também do sistema inteiro)
PORT=3333
# 0.0.0.0 = aceita conexões da rede interna; 127.0.0.1 = só da própria máquina
HOST=0.0.0.0

# --- Banco de dados MySQL 8 (valores compatíveis com o docker-compose.yml) ----
DB_HOST=localhost
DB_PORT=3306
DB_NAME=estoque_provedor
DB_USER=estoque
DB_PASSWORD=estoque123
# Banco usado SOMENTE pelos testes automatizados (é apagado e recriado a cada execução)
DB_NAME_TEST=estoque_provedor_teste

# --- Segurança ----------------------------------------------------------------
# Segredo dos tokens de login: longo e aleatório (o "npm run configurar" gera um).
# Em produção a API não inicia com o valor de exemplo abaixo.
JWT_SECRET=troque-este-segredo-por-um-valor-longo-e-aleatorio
# Validade da sessão (ex.: 10h, 8h, 1d)
JWT_EXPIRACAO=10h
# (Opcional) origens permitidas no CORS, separadas por vírgula.
# Em produção o front-end é servido pela própria API e o CORS fica desligado.
# CORS_ORIGIN=http://localhost:5173
# (Opcional) só se a API ficar atrás de um proxy reverso (Nginx etc.)
# TRUST_PROXY=1

# --- Produção -----------------------------------------------------------------
# A API entrega o front-end compilado (frontend/dist). Padrão: true em produção.
# SERVIR_FRONTEND=true
# (Opcional) HTTPS — necessário para liberar a câmera do celular pela rede.
# Caminhos dos arquivos do certificado e da chave (ver docs/GUIA_INSTALACAO.md).
# HTTPS_CERT=C:\certificados\estoque.pem
# HTTPS_KEY=C:\certificados\estoque-chave.pem

# --- Backups ------------------------------------------------------------------
# Pasta dos arquivos de backup (padrão: backend/backups). Deve ser acessível só
# pelo usuário que roda a API. A frequência e a retenção ficam em Configurações.
# BACKUP_DIR=D:\backups-estoque

# --- E-mail (opcional) --------------------------------------------------------
# Para enviar as notificações por e-mail. Ative também em Configurações.
# SMTP_HOST=smtp.seuprovedor.com.br
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=estoque@seuprovedor.com.br
# SMTP_PASS=senha-do-email
# SMTP_FROM="Estoque <estoque@seuprovedor.com.br>"
