# Porta da API
PORT=3333

# Banco de dados MySQL (valores compatíveis com o docker-compose.yml)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=estoque_provedor
DB_USER=estoque
DB_PASSWORD=estoque123

# Segredo para assinar os tokens JWT (troque por um valor longo e aleatório)
JWT_SECRET=troque-este-segredo-por-um-valor-longo-e-aleatorio

# (Opcional) origens permitidas no CORS, separadas por vírgula
CORS_ORIGIN=http://localhost:5173

# (Opcional) só se a API ficar atrás de um proxy reverso (Nginx etc.)
# TRUST_PROXY=1
